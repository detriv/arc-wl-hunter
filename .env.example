# ═══════════════════════════════════════════════════
# Arc NFT Whitelist Hunter — Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════

# ── Telegram ────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID (your personal chat with the bot)
TELEGRAM_CHAT_ID=

# Discord (optional) — Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# ── X (Twitter) Session ─────────────────────────────
# Cara dapat: buka x.com di Chrome → F12 → Application → Cookies
# Copy value "auth_token" dan "ct0"
X_AUTH_TOKEN=
X_CT0=

# Twitter API v2 (for cloud deployment where cookies don't work)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# Provider selection (cloud):
# USE_TWITTER_API=true  → use Twitter API v2 (Bearer Token, $100/mo)
# USE_NITTER=true       → use Nitter RSS (free, no key)
# USE_HTTP_PROVIDER=true → use HTTP GraphQL (cookies, no browser)
# (not set)             → use Playwright (local, browser)
USE_TWITTER_API=
USE_NITTER=
USE_HTTP_PROVIDER=

# Nitter instance (optional, auto-detect if not set)
NITTER_URL=

# ── Browser ─────────────────────────────────────────
# Directory for persistent browser profile
BROWSER_PROFILE_DIR=data/browser-profile

# Run browser in headless mode (true/false)
BROWSER_HEADLESS=false

# ── Monitoring ──────────────────────────────────────
# Seconds between full monitoring cycles
POLL_INTERVAL_SECONDS=300

# ── Search Behavior ─────────────────────────────────
# Delay between searches (seconds)
SEARCH_DELAY_SECONDS=2

# Delay between scrolls (seconds)
SCROLL_DELAY_SECONDS=2

# Maximum posts to collect per query
MAX_POSTS_PER_QUERY=50

# Maximum scrolls per query
MAX_SCROLLS_PER_QUERY=10

# ── Scoring ─────────────────────────────────────────
# Minimum score to send notification (0-100)
MIN_SCORE=60

# Score threshold for HIGH priority (0-100)
HIGH_PRIORITY_SCORE=80

# ── Logging ─────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
